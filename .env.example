# Required — OpenAI API key with access to the selected image model
OPENAI_API_KEY=sk-...

# Required — HMAC key used to sign /images/{asset_id} URLs.
# Generate with:  openssl rand -hex 32
IMAGE_URL_SIGNING_KEY=

# Optional — model selection
# OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst # candidate default; manual alternative gpt-image-2.6-flare
# OPENAI_REFINE_MODEL=gpt-5.5             # refine_image (Responses API)
# OPENAI_REFINE_REASONING_EFFORT=low      # tool-call effort, not strategy

# Optional — image URL TTL in seconds (default 86400 = 24h)
# IMAGE_URL_TTL_SECONDS=86400

# Optional — server config
# HOST=0.0.0.0
# PORT=8080
# MCP_TRANSPORT=stdio                     # set to use stdio instead of HTTP

# Required on Cloud Run — public URL for image and upload links.
# Without this, image URLs fall back to localhost which breaks in production.
# PUBLIC_URL=https://your-service.run.app

# Optional — S3 storage (durable image URLs; v0.2)
# S3_BUCKET=gpt-image-2-cache
# S3_PREFIX=gpt-image-2
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Optional — GCS storage (used if S3_BUCKET not set; v0.2)
# GCS_BUCKET=gpt-image-2-cache
# GCS_PREFIX=gpt-image-2

# Optional — bearer token for POST /upload (v0.2)
# Unset = endpoint is open (single-tenant dev).
# MCP_BEARER_TOKEN=

# Optional — cost guardrails
# MAX_COUNT_PER_REQUEST=4
# MAX_QUALITY=high

# Optional — single-instance rate limit (per-IP, 60s sliding window).
# Applies to POST /upload and POST /api/{tool}. Unset/0 = unlimited.
# This is a safety net only — for multi-instance Cloud Run, use Cloud Armor at the edge.
# RATE_LIMIT_PER_MINUTE=60

